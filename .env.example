# ==============================================================================
# AI CAREER GUIDANCE - ENVIRONMENT CONFIGURATION (PART 2 & PART 3)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE AUTHENTICATION (PUBLIC CLIENT KEYS)
# ------------------------------------------------------------------------------
# Obtained from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & STORAGE (PUBLIC CLIENT KEYS)
# ------------------------------------------------------------------------------
# Obtained from: Supabase Dashboard -> Project Settings -> API
# Note: In Supabase Third-Party Auth, the client passes the Firebase JWT.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key_here

# ------------------------------------------------------------------------------
# 3. FIREBASE ADMIN SDK (SERVER-ONLY - NEVER EXPOSE TO FRONTEND)
# ------------------------------------------------------------------------------
# Obtained from: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# Used exclusively server-side to provision the 'role: authenticated' claim for Supabase RLS.
FIREBASE_ADMIN_PROJECT_ID="your_firebase_project_id"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com"
# Format: Replace newlines with \n in the private key string, or supply the path/JSON
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 4. SUPABASE SERVICE ROLE (SERVER-ONLY - OPTIONAL / PRIVILEGED OPERATIONS)
# ------------------------------------------------------------------------------
# Obtained from: Supabase Dashboard -> Project Settings -> API -> service_role secret
# WARNING: NEVER prefix with NEXT_PUBLIC_. Bypasses all Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
